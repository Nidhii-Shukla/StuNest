# Supabase Configuration
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Groq API Key (powers AI chatbot using llama-3.1-8b-instant — free tier available)
# Get from: https://console.groq.com
VITE_GROQ_API_KEY=your-groq-api-key-here

# Google Maps API Key (for verified distance calculation, map embeds, directions)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API, Distance Matrix API, Maps Embed API
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Backend Proxy URL (deployed on Railway)
VITE_BACKEND_URL=https://your-app-name.up.railway.app
